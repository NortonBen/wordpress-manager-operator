# Processed by the nginx image entrypoint (envsubst on ${API_UPSTREAM}) →
# /etc/nginx/conf.d/default.conf. nginx variables ($host, $uri, …) are NOT env
# vars and are left untouched by the filtered envsubst.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the apiserver so the UI image is self-contained — login
    # works on direct access / port-forward, not only behind a path-splitting
    # Ingress. Without a trailing path on proxy_pass, the full /api/... URI is
    # forwarded unchanged (the apiserver serves /api/v1/...).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
