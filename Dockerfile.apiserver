# Build the admin REST API binary.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/apiserver ./cmd/apiserver

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/apiserver /apiserver
USER 65532:65532
EXPOSE 8090
ENTRYPOINT ["/apiserver"]
